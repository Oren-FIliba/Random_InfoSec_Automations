TG_API_ID="your_api_id"
TG_API_HASH="your_api_hash"
TG_PHONE="+1234567890"

# Telegram source for supply chain monitor script is already preset.
WEBHOOK_URL="http://127.0.0.1:8080/event/npm-alert"
WEBHOOK_TOKEN="change_me"

INGEST_API_TOKEN="change_me"
INGEST_API_HOST="0.0.0.0"
INGEST_API_PORT="8080"

PIPELINE_BASE_DIR="."
PIPELINE_DATA_DIR="./pipeline_data"

WORKER_POLL_INTERVAL="2"
WORKER_TIMEOUT_SECONDS="180"
LOG_LEVEL="INFO"
LOG_FILE="./pipeline_data/pipeline.log"

SLACK_WEBHOOK_URL=""
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# AI static analysis
AI_PROVIDER="opencode_local"

# Local OpenCode execution mode:
# stdin -> pass prompt via stdin
# arg   -> pass prompt as a single CLI arg
# file  -> pass temp prompt file path as last arg
OPENCODE_CMD="opencode"
OPENCODE_ARGS="run"
OPENCODE_MODE="arg"
OPENCODE_TIMEOUT_SECONDS="900"

# Optional direct API provider fallback
OPENAI_API_KEY=""
OPENAI_MODEL="openai/gpt-5.3-codex"
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_MAX_FILES="12"
AI_MAX_CHARS_PER_FILE="5000"
AI_BATCH_SIZE="40"
AI_MAX_RETRIES="2"
AI_TARGET_EXTENSIONS=".js,.cjs,.mjs,.ts,.json,.sh"
